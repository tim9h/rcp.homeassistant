<project xmlns="http://maven.apache.org/POM/4.0.0"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>

	<artifactId>rcp.homeassistant</artifactId>
	<packaging>jar</packaging>
	<version>0.0.1-SNAPSHOT</version>

	<parent>
		<groupId>dev.tim9h</groupId>
		<artifactId>rcp.parent</artifactId>
		<version>1.1.0-SNAPSHOT</version>
	</parent>

	<properties>
		<plugin.outputDirectory>${project.build.directory}</plugin.outputDirectory>
	</properties>

	<repositories>
		<repository>
			<id>gh-read-packages</id>
			<name>GitHub Packages</name>
			<url>https://maven.pkg.github.com/tim9h/rcp</url>
			<snapshots>
				<enabled>true</enabled>
			</snapshots>
		</repository>
		<repository>
			<id>jitpack.io</id>
			<url>https://jitpack.io</url>
		</repository>
	</repositories>

	<dependencyManagement>
		<dependencies>
			<dependency>
				<groupId>dev.tim9h</groupId>
				<artifactId>rcp.api</artifactId>
				<version>${project.parent.version}</version>
			</dependency>
			<dependency>
				<groupId>dev.tim9h</groupId>
				<artifactId>rcp.controls</artifactId>
				<version>${project.parent.version}</version>
			</dependency>
		</dependencies>
	</dependencyManagement>

	<dependencies>

		<dependency>
			<groupId>dev.tim9h</groupId>
			<artifactId>rcp.api</artifactId>
		</dependency>

		<dependency>
			<groupId>dev.tim9h</groupId>
			<artifactId>rcp.controls</artifactId>
		</dependency>

		<dependency>
			<groupId>org.apache.logging.log4j</groupId>
			<artifactId>log4j-api</artifactId>
		</dependency>

		<dependency>
			<groupId>com.github.thibstars</groupId>
			<artifactId>JHAAPI</artifactId>
			<version>1.0.17</version>
		</dependency>

	</dependencies>

	<build>

		<plugins>

			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-compiler-plugin</artifactId>
			</plugin>

			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-jar-plugin</artifactId>
				<configuration>
					<outputDirectory>${plugin.outputDirectory}</outputDirectory>
				</configuration>
			</plugin>

			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-shade-plugin</artifactId>
				<configuration>
					<createDependencyReducedPom>false</createDependencyReducedPom>
					<filters>
						<filter>
							<artifact>*:*</artifact>
							<excludes>
								<exclude>module-info.class</exclude>
								<exclude>META-INF/versions/**/module-info.class</exclude>
								<exclude>META-INF/MANIFEST.MF</exclude>
							</excludes>
						</filter>
					</filters>
				</configuration>
				<executions>
					<execution>
						<phase>package</phase>
						<goals>
							<goal>shade</goal>
						</goals>
						<configuration>
							<artifactSet>
								<includes>
									<include>com.github.thibstars:JHAAPI</include>
									<include>
										com.fasterxml.jackson.datatype:jackson-datatype-jsr310</include>
									<include>
										org.apache.httpcomponents.core5:httpcore5</include>
									<include>com.squareup.okhttp3:okhttp</include>
									<include>com.squareup.okhttp3:okhttp-jvm</include>
									<include>
										com.fasterxml.jackson.core:jackson-core</include>
									<include>
										com.fasterxml.jackson.core:jackson-databind</include>
									<include>
										com.fasterxml.jackson.core:jackson-annotations</include>
									<include>org.jetbrains.kotlin:kotlin-stdlib</include>
									<include>com.squareup.okio:okio-jvm</include>
								</includes>
							</artifactSet>
							<transformers>
								<transformer
									implementation="org.apache.maven.plugins.shade.resource.AppendingTransformer">
									<resource>META-INF/LICENSE</resource>
								</transformer>
								<transformer
									implementation="org.apache.maven.plugins.shade.resource.AppendingTransformer">
									<resource>META-INF/NOTICE</resource>
								</transformer>
							</transformers>
						</configuration>
					</execution>
				</executions>
			</plugin>

		</plugins>

	</build>

</project>
